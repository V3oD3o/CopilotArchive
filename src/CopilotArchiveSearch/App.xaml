                <ResourceDictionary Source="Themes/GridSplitter.xaml"/>
                <ResourceDictionary Source="Themes/ListBoxDark.xaml"/>
                <ResourceDictionary Source="Themes/Toolbar.xaml"/>
                <ResourceDictionary Source="Themes/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/TextControls.xaml"/>
