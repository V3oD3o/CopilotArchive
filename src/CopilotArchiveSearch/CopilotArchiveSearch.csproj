<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\IDR_X004_DEV.ico</ApplicationIcon>

    <AssemblyName>CopilotArhiveSearch</AssemblyName>
    <RootNamespace>Brx.CopilotArhiveSearch</RootNamespace>
    <CLSCompliant>true</CLSCompliant>

    <AssemblyTitle>CopilotArhiveSearch</AssemblyTitle>
    <Company>N/A</Company>
    <Product>CopilotArhiveSearch</Product>
    <Copyright>Copyright (C) 2026 Daniel Vargha</Copyright>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\markdown-dark.css" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\markdown-dark.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.3" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

</Project>
